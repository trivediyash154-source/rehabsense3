# ---------------------------------------------------------------------------
# RehabSense backend configuration
# Nothing here is required for local development: the defaults run against a
# zero-setup SQLite file. Everything below is read from the environment.
# ---------------------------------------------------------------------------

# --- runtime ---
DEBUG=true
LOG_LEVEL=INFO

# --- database ---
# SQLite by default. Point at PostgreSQL for production; the same models and
# migrations run unchanged.
DATABASE_URL=sqlite:///./rehabsense.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rehabsense

# --- security ---
# REQUIRED in production. Must be at least 32 bytes; the app refuses to start
# with the development default when DEBUG=false.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14

# --- CORS ---
# Explicit origins only, never a wildcard. Comma-separated or a JSON array.
# A browser silently blocking requests looks exactly like "backend is down",
# so set this to the origin the frontend actually runs on.
#
# With DEBUG=false the app refuses to start unless every entry is a real
# origin (scheme://host[:port], no path), none is "*", and non-loopback
# entries use https. Those checks run in the startup lifespan, so a
# misconfigured deployment fails at boot instead of quietly serving patient
# data to any site that asks.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- signal processing (documented defaults; change only with good reason) ---
SAMPLE_RATE_HZ=100
CALIBRATION_SECONDS=2.5
COMPLEMENTARY_ALPHA=0.98
LOWPASS_CUTOFF_HZ=5.0
FSR_STANCE_THRESHOLD=0.15

# --- recovery score weights (must sum to 1.0) ---
WEIGHT_ROM=0.30
WEIGHT_SYMMETRY=0.25
WEIGHT_COMPLIANCE=0.20
WEIGHT_CADENCE=0.15
WEIGHT_PAIN=0.10

# --- normalisation references ---
TARGET_ROM_DEG=135
REFERENCE_CADENCE_SPM=110

# --- analytics versioning ---
# Recorded on every session and report so historical figures stay
# interpretable after the formulas change.
ANALYTICS_VERSION=mvp-1.0
