# ---------------------------------------------------------------------------
# RehabSense BACKEND (FastAPI) environment
#
# ENVIRONMENT selects the posture:
#   development  zero-setup defaults (SQLite, local storage, simulators allowed)
#   test         used by pytest (tests/conftest.py)
#   production   strict: the API refuses to start unless DATABASE_URL (PostgreSQL),
#                SECRET_KEY, CORS_ORIGINS, COOKIE_SECURE and STORAGE_BACKEND are
#                set explicitly, DEBUG=false, and the schema is at the Alembic
#                head. Unregistered devices are refused; simulators only if
#                ALLOW_SIMULATED_DEVICES=true is set explicitly.
#
# Never commit a real .env. Secrets come from the hosting platform's secret store.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# development: SQLite file (development only, never production persistence)
DATABASE_URL=sqlite:///./rehabsense.db
# production (required, PostgreSQL 16 validated):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/rehabsense?sslmode=require

# --- security ---------------------------------------------------------------
# production: >= 32 bytes, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14
# production: true (cookies only over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Exact frontend origin(s); never "*". production: https://your-project.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- social sign-in (optional) ----------------------------------------------
# A provider is offered only when its id AND secret are set. Secrets live in
# the host's secret store (Vercel: Sensitive), never in a NEXT_PUBLIC_ variable.
# Redirect URIs must be on the WEBSITE origin (the /api/* proxy), so the
# session cookie stays first-party; unset, they default to
# <first CORS origin>/api/auth/<provider>/callback. See GOOGLE_OAUTH_SETUP.md
# and FACEBOOK_OAUTH_SETUP.md.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://your-project.vercel.app/api/auth/facebook/callback
# FACEBOOK_GRAPH_VERSION=v25.0
# OAUTH_STATE_MINUTES=10

# --- devices ----------------------------------------------------------------
# Fleet key for devices without their own key (simulators). Registered devices
# always authenticate with their own key (POST /api/devices/register).
# DEVICE_INGEST_KEY=
ALLOW_SIMULATED_DEVICES=true
# Forced true in production.
REQUIRE_REGISTERED_DEVICES=false

# --- object storage (exports, raw archives) ---------------------------------
# development: local directory
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
# production: S3-compatible (AWS S3, Cloudflare R2, MinIO). Credentials via the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables.
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=rehabsense-recordings
# STORAGE_S3_PREFIX=rehabsense/
# STORAGE_S3_ENDPOINT_URL=          # for R2/MinIO
# STORAGE_S3_REGION=eu-west-2

# --- raw sensor retention ---------------------------------------------------
STORE_RAW_SAMPLES=true
RAW_SAMPLE_RETENTION_DAYS=30

# --- ML model bundles (inference only; training happens in ml/) -------------
# development: the ml/ artifacts directory. In the Docker image: /app/models.
ML_MODEL_DIR=../ml/artifacts
ML_ACTIVITY_MODEL=activity_bilateral
ML_ACTIVITY_MODEL_SINGLE=activity_single_side
# ML_ACTIVITY_MODEL_VERSION=v1        # default: highest vN found

# --- hardware v2 pipeline ---------------------------------------------------
HW_CALIBRATION_HEALTH_S=1.0
HW_CALIBRATION_STILL_S=3.0
HW_CALIBRATION_MOVEMENT_S=5.0
HW_WINDOW_S=2.0
HW_STRIDE_S=0.5

# --- request limits ---------------------------------------------------------
MAX_REQUEST_BYTES=1000000

# --- v1 signal processing / recovery score (documented defaults) ------------
SAMPLE_RATE_HZ=100
CALIBRATION_SECONDS=2.5
COMPLEMENTARY_ALPHA=0.98
LOWPASS_CUTOFF_HZ=5.0
FSR_STANCE_THRESHOLD=0.15
WEIGHT_ROM=0.30
WEIGHT_SYMMETRY=0.25
WEIGHT_COMPLIANCE=0.20
WEIGHT_CADENCE=0.15
WEIGHT_PAIN=0.10
TARGET_ROM_DEG=135
REFERENCE_CADENCE_SPM=110
ANALYTICS_VERSION=mvp-1.0
