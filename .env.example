# ---------------------------------------------------------------------------
# RehabSense FRONTEND (Next.js) environment
#
# Development: copy to .env.local; every value below has a localhost default.
# Production (Vercel): set these in the Vercel project settings. The build
# FAILS if BACKEND_ORIGIN / NEXT_PUBLIC_WS_URL / NEXT_PUBLIC_SITE_URL are
# missing or not https/wss (lib/config.server.ts). There is no silent localhost
# fallback on Vercel. See VERCEL_DEPLOYMENT.md.
#
# Never prefix a secret with NEXT_PUBLIC_ -- that inlines it into browser JS.
# The backend has its own file: backend/.env.example.
# ---------------------------------------------------------------------------

# --- RehabSense API ---------------------------------------------------------
# Server-only. Next proxies /api/* here (same-origin, so the HttpOnly session
# cookie stays first-party with SameSite=Lax).
#   development: http://localhost:8000
#   production:  https://api.your-domain.example
#   frontend-only deployment (API not hosted yet): the literal value  none
#     -> /api/* answers 503 BACKEND_NOT_CONNECTED, sign-in is unavailable and
#        the UI says so; NEXT_PUBLIC_WS_URL is then not required.
BACKEND_ORIGIN=http://localhost:8000

# Browser: WebSocket origin of the API (live dashboard). WebSockets cannot go
# through the Next/Vercel proxy, so this is the API host itself.
#   development: ws://localhost:8000
#   production:  wss://api.your-domain.example
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Canonical origin of this site (metadata, sitemap).
#   production: https://your-project.vercel.app (or custom domain). On Vercel,
#   if unset, the project's production domain (VERCEL_PROJECT_PRODUCTION_URL)
#   is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact delivery (optional) -------------------------------------------
# Server-only HTTPS endpoint receiving validated contact submissions. While
# empty, /api/contact returns 503 and the form says delivery is not connected.
CONTACT_DELIVERY_URL=
CONTACT_DELIVERY_TOKEN=
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600

# --- Product analytics (optional, off by default) ---------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_TOKEN=

# Optional demo convenience; leave empty for a public contact form.
NEXT_PUBLIC_CONTACT_PREFILL_NAME=
