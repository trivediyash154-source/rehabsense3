# ---------------------------------------------------------------------------
# RehabSense — environment configuration
#
# Nothing here is required to run the prototype. Every integration below is
# OFF by default, and the UI states plainly when a capability is not connected.
# Never prefix a secret with NEXT_PUBLIC_ — that inlines it into client JS.
# ---------------------------------------------------------------------------

# --- Contact delivery ------------------------------------------------------
# Server-only HTTPS endpoint that accepts the validated contact payload as JSON.
# The endpoint owns storage, delivery, abuse protection, and retention.
# While CONTACT_DELIVERY_URL is empty the API returns 503 and the form shows an
# honest "delivery is not connected" state. It never fakes a success screen.
CONTACT_DELIVERY_URL=
CONTACT_DELIVERY_TOKEN=

# Fixed-window in-memory rate limit for the contact route (single instance only).
# Put a shared/edge rate limiter in front of this before any public deployment.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600

# --- Product analytics -----------------------------------------------------
# Events are off unless BOTH the public flag and the server ingest URL are set.
# Only allowlisted event names and allowlisted property values are ever sent.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_TOKEN=

# --- Authentication --------------------------------------------------------
# Authentication is intentionally NOT implemented. /api/auth rejects every
# request with 503 AUTH_NOT_CONFIGURED and never parses credentials, so no
# account, session, token or verification code can be created.
#
# Setting this to "true" alone does NOT enable authentication. It only exists
# so that, once a reviewed server-side adapter is installed in
# lib/server/auth-adapter.ts, the UI can drop its "Demo mode" badge.
AUTH_ADAPTER_ENABLED=false

# Provider credentials belong in the server adapter, never in client code:
#   GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
#   FACEBOOK_CLIENT_ID= / FACEBOOK_CLIENT_SECRET=
#   SMS_PROVIDER_TOKEN=
# They are listed here as documentation only and are not read anywhere yet.

# --- Contact form convenience ---------------------------------------------
# Optional. Prefills the contact form's name field (e.g. for a demo recording).
# Leave empty for a normal public contact form.
NEXT_PUBLIC_CONTACT_PREFILL_NAME=

# Canonical origin, used for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend ---------------------------------------------------------------
# Where this app's server proxies /api/* to. Server-side only: the browser
# calls this app's own origin, which is what makes the session cookie
# first-party (HttpOnly + SameSite=Lax) instead of a cross-site cookie.
BACKEND_ORIGIN=http://localhost:8000

# Public origin of the backend, used ONLY for the live-session WebSocket,
# which cannot go through Next's rewrite proxy. That socket authorises itself
# with a short-lived ticket from /api/auth/ws-ticket, never with the cookie.
# The backend's CORS_ORIGINS must include this frontend's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
